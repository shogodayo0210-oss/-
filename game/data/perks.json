{
  "_comment": "アバター特典のカタログ。cost は勝率への寄与で後から動かす前提の仮価格。",
  "budget": {
    "max_total": 10,
    "min_total": 9,
    "category_caps": {
      "info": 2,
      "draft": 2,
      "combat_active": 1,
      "combat_passive": 2,
      "tempo": 2
    }
  },
  "perks": [
    { "id": "scout_1",     "name": "索敵Ⅰ",     "category": "info",           "cost": 5, "resolves_in": "intel",  "visible_to_opponent": true,
      "params": { "reveal_from": "opponent_chosen", "count": 3, "selection": "random" },
      "note": "公開は両者ロック後。ロック前に見えるとカウンターピック機になる" },
    { "id": "scout_2",     "name": "索敵Ⅱ",     "category": "info",           "cost": 3, "resolves_in": "intel",  "visible_to_opponent": true,
      "params": { "reveal_from": "opponent_random", "count": 2, "selection": "all" } },
    { "id": "mind_read",   "name": "読心",       "category": "info",           "cost": 4, "resolves_in": "intel",  "visible_to_opponent": true,
      "params": { "reveal_from": "opponent_deck", "count": 1, "granularity": "school_only" } },
    { "id": "gauge_sight", "name": "検算",       "category": "info",           "cost": 2, "resolves_in": "battle", "visible_to_opponent": true,
      "params": { "show": "opponent_gauge", "duration": "always" } },
    { "id": "pick_plus",   "name": "選抜+1",     "category": "draft",          "cost": 6, "resolves_in": "draft",  "visible_to_opponent": true,
      "params": { "chosen_slots": 7, "random_slots": 1 },
      "note": "6→8 は編成システムそのものを消すので +1 に留める" },
    { "id": "reroll",      "name": "引き直し",   "category": "draft",          "cost": 4, "resolves_in": "draft",  "visible_to_opponent": true,
      "params": { "reroll_random_slots": 1 } },
    { "id": "promote",     "name": "抜擢",       "category": "draft",          "cost": 4, "resolves_in": "draft",  "visible_to_opponent": true,
      "params": { "tier_shift": 1 } },
    { "id": "reserve",     "name": "予備兵",     "category": "draft",          "cost": 3, "resolves_in": "draft",  "visible_to_opponent": true,
      "params": { "team_size": 9, "chosen_slots": 6, "random_slots": 3 } },
    { "id": "immortal",    "name": "不動",       "category": "combat_active",  "cost": 6, "resolves_in": "battle", "visible_to_opponent": true,
      "params": { "charges": 1, "invuln_sec": 2.0, "can_attack_during": false, "cleanses_stun": false, "telegraph_sec": 0.3 },
      "note": "2秒残すなら攻撃不可は必須。攻撃も通すなら1.2秒まで下げる" },
    { "id": "escape",      "name": "緊急離脱",   "category": "combat_active",  "cost": 5, "resolves_in": "battle", "visible_to_opponent": true,
      "params": { "charges": 2, "invuln_sec": 0.8, "dash_back": true } },
    { "id": "last_stand",  "name": "起死回生",   "category": "combat_passive", "cost": 4, "resolves_in": "battle", "visible_to_opponent": true,
      "params": { "trigger": "last_character", "max_hp_bonus": 0.2, "once": true } },
    { "id": "head_start",  "name": "先手",       "category": "tempo",          "cost": 3, "resolves_in": "battle", "visible_to_opponent": true,
      "params": { "start_gauge": 30 } },
    { "id": "quick_cast",  "name": "詠唱短縮",   "category": "tempo",          "cost": 5, "resolves_in": "battle", "visible_to_opponent": true,
      "params": { "cast_time_mult": 0.7 } },
    { "id": "recall",      "name": "追憶",       "category": "tempo",          "cost": 7, "resolves_in": "battle", "visible_to_opponent": true,
      "params": { "reuse_spent_card": 1, "cost_mult": 2.0 } }
  ]
}
